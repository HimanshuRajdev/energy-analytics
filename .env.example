# EIA
EIA_API_KEY=

# AWS S3 (raw files). Use an IAM user that can only touch this bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# Google Cloud / BigQuery
GCP_PROJECT=
BQ_LOCATION=US
# Path to the service account key, used when you run scripts directly (python -m scripts...).
# Docker overrides this with its own path. The same account covers BigQuery and the Sheet.
GOOGLE_APPLICATION_CREDENTIALS=secrets/gcp.json

# Google Sheet that Tableau Public reads. Share it with the service account as Editor.
# The ID is the long string in the sheet URL between /d/ and /edit
SHEET_ID=

# Airflow (docker compose reads these). Generate the two keys with:
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=
AIRFLOW_ADMIN_PASSWORD=
